# Anthropic API key — required
ANTHROPIC_API_KEY=sk-ant-api03-...

# Layer 4 Core API key — protects the /analyze endpoint (see step 3)
LAYER4_API_KEY=change-me-to-a-strong-random-secret

# Server port (default: 3000)
PORT=3000

# Set to 1 to log raw API block shapes to stderr (debug only)
DEBUG_BLOCKS=0
